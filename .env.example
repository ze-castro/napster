# Copy to .env next to compose.yaml and fill in.

# The exact URL you open napster at (scheme, host and port). Saving settings fails otherwise.
ORIGIN=http://localhost:3000

# Folder on this machine that holds your music. It's mounted at /music inside the container.
MUSIC_DIR=/path/to/music

# Port napster listens on, on the host and in the container.
PORT=3000

# Prebuilt image to pull. Leave commented out to build locally with `docker compose up -d --build`.
# NAPSTER_IMAGE=ghcr.io/<github-user>/napster:latest
